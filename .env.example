# No environment variables are required for basic Hyperframes usage.
# Run `bun run dev` to start Studio, or `npx hyperframes render` to render video.

# Optional Gemini key used by AI image captioning during website capture.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== TTS providers =====
# TTS_PROVIDER can be `elevenlabs` or `gemini`.
TTS_PROVIDER=elevenlabs

# ElevenLabs voiceover.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_SAMPLE_RATE=24000

# Gemini TTS fallback.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Aoede

# ===== Platform publishing APIs =====
# Instagram API with Instagram Login.
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_USER_ID=me

# Threads Publishing API.
THREADS_ACCESS_TOKEN=
THREADS_APP_SECRET=

# YouTube Data API v3.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Public media hosting for IG / Threads video_url and cover_url.
# Use a production HTTPS URL, such as Cloudflare R2 with a custom domain.
PUBLIC_MEDIA_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=
